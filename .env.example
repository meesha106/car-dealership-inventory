# Copy to .env locally, replace placeholders, and keep the file untracked.
POSTGRES_PASSWORD=replace-with-a-strong-local-database-password
DATABASE_URL=postgresql://car_dealership:replace-with-a-strong-local-database-password@localhost:5432/car_dealership
TEST_DATABASE_URL=postgresql://car_dealership:replace-with-a-strong-local-database-password@localhost:5432/car_dealership_test
PORT=3000
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
FRONTEND_ORIGIN=http://localhost:5173
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=replace-with-a-strong-password-at-least-12-characters
